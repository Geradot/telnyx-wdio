{
  "name": "telnyx-wdio",
  "version": "1.0.0",
  "description": "Testing Telnyx using WDIO",
  "license": "ISC",
  "author": "Geradot",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:chrome": "cross-env BROWSER=chrome wdio run wdio.conf.js",
    "test:firefox": "cross-env BROWSER=firefox wdio run wdio.conf.js",
    "test:headless": "cross-env HEADLESS=true wdio run wdio.conf.js",
    "report": "allure generate allure-results --clean && allure open"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.20.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "@wdio/visual-service": "^9.0.0",
    "cross-env": "^10.1.0"
  }
}
